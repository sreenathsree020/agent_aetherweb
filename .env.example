# ==============================================================================
# AI Voice Agent Backend Infrastructure Configuration
# (Store, LLM, Telephony, WhatsApp, and Addon settings are configured dynamically via Frontend)
# ==============================================================================

# ----------------------- Core Database & Encryption -----------------------
# Live Aiven / PostgreSQL database storing call history, store schemas, and encrypted addon configs
DATABASE_URL=postgres://avnadmin:password@pg-host.aivencloud.com:15983/defaultdb?sslmode=no-verify
SECRET_KEY=dev-key-please-change-in-prod-secure
ENCRYPTION_MASTER_KEY=uYw7Zc2M5bQ3vX8nK1rL9pT0eW4yA6dF8gH2jK4mN7s=

# ----------------------- Server-Level Voice Engine (STT & TTS) -----------------------
# Used for real-time binary audio stream transcription and voice synthesis
STT_PROVIDER=deepgram
TTS_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_MODEL=aura-asteria-en

# Optional fallback speech engine
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# ----------------------- Redis / Session Memory Store -----------------------
REDIS_URL=rediss://default:password@valkey-host.aivencloud.com:21234
SESSION_TIMEOUT=3600

# ----------------------- Server Runtime Settings -----------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
